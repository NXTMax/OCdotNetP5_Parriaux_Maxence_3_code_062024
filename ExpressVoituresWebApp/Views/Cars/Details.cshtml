@model ExpressVoituresWebApp.Data.Car

@{
	ViewData["Title"] = "Details";
	bool adminView = User.Identity?.Name == "jaques.dupont@expressvoitures.fr";
}

<h1>Details</h1>
<div>
	<h4>Car</h4>
	<hr />
	<a asp-action="Index" id="backToList">← Retour</a>
	<article>
			<img src="@Model.ImageUrl" alt="@Model.Model" />
		<div>
			@if (adminView)
			{
				<div class="adminInfo">
					<p>Vous avez publié cette annonce, vous pouvez la :</p>
					<div>
						<a asp-action="Edit" asp-route-id="@Model?.Vin">modifier</a>
						<a asp-action="Delete" asp-route-id="@Model?.Vin">supprimer</a>
					</div>
				</div>
			}
			<div class="carInfo">
				<h3>@(Model.ResellPrice.HasValue ? @Model.ResellPrice + " €" : "")</h3>
				<p>@Model.Model?.Year</p>
				<p>@Model.Model?.Manufacturer</p>
				<p>@Model.Model?.Name</p>
				<p>@Model.Model?.Finition</p>
			</div>
		</div>
	</article>
