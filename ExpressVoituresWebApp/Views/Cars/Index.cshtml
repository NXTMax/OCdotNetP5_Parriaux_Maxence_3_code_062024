@model IEnumerable<ExpressVoituresWebApp.Data.Car>

@{
	ViewData["Title"] = "Nos voitures";
	var currentDate = DateOnly.FromDateTime(DateTime.Now);
	bool adminView = User.Identity?.Name == "jaques.dupont@expressvoitures.fr";
	IEnumerable<ExpressVoituresWebApp.Data.Car> listedCars = Model.Where(c => c.ListingDate < currentDate);
}

<h1>Nos voitures</h1>

@if (adminView)
{
	<p class="text-center">
		<a id="addCarBtn" class="btn" asp-action="Create">+Ajouter une voiture</a>
	</p>
}

<section id="carList">
	@foreach (var item in adminView ? Model : listedCars)
	{
		<a asp-action="Details" asp-route-id="@item.Vin">
			<article>
				<img src="@item.ImageUrl" alt="@item.Model" />
				<div class="carInfo">
					<h3>@(item.ResellPrice.HasValue ? @item.ResellPrice + " €" : "" )</h3>
					<p>@item.Model?.Year</p>
					<p>@item.Model?.Manufacturer</p>
					<p>@item.Model?.Name</p>
					<p>@item.Model?.Finition</p>
				</div>
			</article>
		</a>
	}
</section>

